<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Zoológico</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <a class="marca" asp-controller="Animais" asp-action="Listar">
            <span class="icone i-pata"></span> Zoológico
        </a>
        <nav>
            <a asp-controller="Animais" asp-action="Listar">Animais</a>
            <a asp-controller="Animais" asp-action="Cadastrar">Novo animal</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>Zoológico - ASP.NET Core MVC</footer>

    <dialog id="modal">
        <h2 id="modalTitulo"></h2>
        <p id="modalTexto"></p>
        <div class="modal-botoes">
            <button type="button" id="modalCancelar" class="secundario">
                <span class="icone i-x"></span> Cancelar
            </button>
            <button type="button" id="modalConfirmar">
                <span class="icone i-check"></span> <span id="modalConfirmarTexto">Confirmar</span>
            </button>
        </div>
    </dialog>

    <script src="~/js/site.js"></script>
</body>
</html>
